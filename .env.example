# ==============================================================================
# Corporate Internal Knowledge Base - Environment Configuration
# ==============================================================================

# Flask Session Security Key
SECRET_KEY=corporate-kb-super-secret-key-2026

# Storage Mode: 'auto' (tries S3, falls back to mirror), 's3' (strict AWS), or 'local'
STORAGE_MODE=auto

# AWS S3 Configuration
S3_BUCKET_NAME=corporate-knowledge-base-store
AWS_DEFAULT_REGION=us-east-1

# Optional explicit credentials (Best practice on EC2 is using IAM Instance Profile instead!)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Application Port
PORT=5000
